# Copy to config.env and adjust for your VPC / Route53 zone.
# config.env is gitignored — do not commit real IPs or passwords.

DOMAIN_NAME=roboshop.internal

# Prefer DNS names created by roboshop.sh (mongodb.$DOMAIN_NAME, ...).
# You can also set plain private IPs here.
MONGODB_HOST=mongodb.roboshop.internal
REDIS_HOST=redis.roboshop.internal
MYSQL_HOST=mysql.roboshop.internal
RABBITMQ_HOST=rabbitmq.roboshop.internal
CATALOGUE_HOST=catalogue.roboshop.internal
USER_HOST=user.roboshop.internal
CART_HOST=cart.roboshop.internal
SHIPPING_HOST=shipping.roboshop.internal
PAYMENT_HOST=payment.roboshop.internal

# Used by mysql.sh / shipping.sh / rabbitmq.sh
MYSQL_ROOT_PASSWORD=RoboShop@1
RABBITMQ_USER=roboshop
RABBITMQ_PASSWORD=roboshop123

# AMI / SG / hosted zone for roboshop.sh (EC2 + Route53 bootstrap)
AMI_ID=ami-09c813fb71547fc4f
SG_ID=sg-xxxxxxxx
ZONE_ID=ZXXXXXXXX
